<div id = "page-title">
    home
</div>
<div id = "page-content">

    hello welcome to my website!!!!

    <div id = "top-projects">
        <h3 style="margin-bottom: 10px;">latest projects:</h3>
        {{#each projects}}
            <a href="/projects/{{name}}">{{title}}</a> - {{subtitle}}
            <br>
        {{/each}}
    </div>
    <br> <br>

    <div id = "top-posts">
        <h3 style="margin-bottom: 10px;">latest blog posts:</h3>
        {{#each posts}}
            <div class="post">
                <a href="/blog/{{name}}">{{title}}</a> - {{subtitle}}
                <br>
            </div>
        {{/each}}
    </div> 
    <br> <br>

    <div id = "badges">
        {{#each badges}}
        <class = "badge">
            <a href="{{link}}" class="pixelated">
                <img src="./badges/{{path}}" alt="{{alt}}">
            </a>
        </class>
        {{/each}}
    </div> 
    <br>

    <div id = "umass-webring">
        <div>
            <a href="{{webring.prev.url}}">{{webring.prev.name}}</a>
        </div>
        <div>
            &lt;&dash;
            <a href="https://github.com/umacabal/umaring">UMass Webring</a>
            &dash;&gt;
        </div>
        <div>
            <a href="{{webring.next.url}}">{{webring.next.name}}</a>
        </div>
    </div>
</div>